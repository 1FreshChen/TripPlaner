# Backend
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AMAP_API_KEY=
AMAP_MCP_ENABLED=true
AMAP_MCP_COMMAND=npx
AMAP_MCP_ARGS=["-y","@amap/amap-maps-mcp-server"]
AMAP_MCP_STARTUP_TIMEOUT_SECONDS=90
AMAP_MCP_CALL_TIMEOUT_SECONDS=20
AMAP_MCP_HTTP_FALLBACK=true
BAIDU_MAP_API_KEY=
UNSPLASH_ACCESS_KEY=
ENABLE_EXTERNAL_SERVICES=true
ENABLE_PLAN_CRITIQUE=true
MAX_REFINEMENT_ROUNDS=3
MIN_PASS_SCORE=7.0
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trip_planner
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=
MAX_CONVERSATION_MESSAGES=20
RATE_LIMIT_PER_MINUTE=5

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
