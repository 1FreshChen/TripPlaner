# Backend
POSTGRES_USER=postgres
# Compose credentials should be long URL-safe values (letters, digits, "-" and "_").
POSTGRES_PASSWORD=
POSTGRES_DB=trip_planner
REDIS_PASSWORD=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AMAP_API_KEY=
AMAP_MCP_ENABLED=true
AMAP_MCP_COMMAND=npx
AMAP_MCP_ARGS=["-y","@amap/amap-maps-mcp-server"]
AMAP_MCP_STARTUP_TIMEOUT_SECONDS=90
AMAP_MCP_CALL_TIMEOUT_SECONDS=20
AMAP_MCP_HTTP_FALLBACK=true
AMAP_QPS_BUDGET=2.0
AMAP_QPS_RETRY_ATTEMPTS=2
AMAP_QPS_RETRY_DELAY_SECONDS=1.0
AMAP_ENRICH_DETAIL_LIMIT=3
BAIDU_MAP_API_KEY=
BAIDU_QPS_BUDGET=2.0
BAIDU_QPS_RETRY_ATTEMPTS=2
BAIDU_QPS_RETRY_DELAY_SECONDS=0.5
BAIDU_MEAL_CONCURRENCY=2
UNSPLASH_ACCESS_KEY=
ENABLE_EXTERNAL_SERVICES=true
# Planner node implementation: pydantic_ai, openai_tools, or deterministic.
PLANNER_BACKEND=pydantic_ai
PYDANTIC_AI_REQUEST_LIMIT=12
PYDANTIC_AI_TOOL_CALL_LIMIT=8
PYDANTIC_AI_TOOL_ROUND_LIMIT=3
ENABLE_PLAN_CRITIQUE=true
MAX_REFINEMENT_ROUNDS=1
MIN_PASS_SCORE=7.0
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trip_planner
REDIS_URL=redis://localhost:6379/0
TASK_RESULT_TTL_DAYS=30
TASK_WORKER_TIMEOUT_SECONDS=900
TASK_SSE_TIMEOUT_SECONDS=300
TRIP_PLANNER_ATTEMPT_TIMEOUT_SECONDS=150
TRIP_PLANNER_MAX_ATTEMPTS=2
PYDANTIC_AI_MODEL_REQUEST_TIMEOUT_SECONDS=90
PLANNER_DRAFT_TIMEOUT_SECONDS=90
PLANNER_DRAFT_MAX_ATTEMPTS=2
PLANNER_CRITIQUE_TIMEOUT_SECONDS=35
PLANNER_REFINE_TIMEOUT_SECONDS=55
PLANNER_GLOBAL_REQUEST_LIMIT=4
TASK_MAINTENANCE_INTERVAL_SECONDS=60
TASK_STALE_QUEUED_SECONDS=300
# Optional. When omitted, DATABASE_URL is converted from asyncpg to a psycopg DSN.
LANGGRAPH_CHECKPOINT_DSN=
LANGGRAPH_WORKFLOW_VERSION=trip_planning_v2
LANGGRAPH_STATE_SCHEMA_VERSION=2
LANGGRAPH_HEARTBEAT_SECONDS=20
LANGGRAPH_STALE_SECONDS=90
LANGGRAPH_RECOVERY_SCAN_SECONDS=30
LANGGRAPH_RECOVERY_QUEUE_STALE_SECONDS=180
LANGGRAPH_MAX_RECOVERIES=3
LANGGRAPH_MEAL_TIMEOUT_SECONDS=60
ENCRYPTION_KEY=
MAX_CONVERSATION_MESSAGES=20
RATE_LIMIT_PER_MINUTE=5

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
