# Images are written automatically by the CD workflow.
BACKEND_IMAGE=ghcr.io/example/trip-planner-backend:sha-example
FRONTEND_IMAGE=ghcr.io/example/trip-planner-frontend:sha-example
RELEASE_SHA=example

# Bind only to loopback; terminate TLS with a host reverse proxy or load balancer.
APP_BIND_IP=127.0.0.1
APP_PORT=8080
FRONTEND_ORIGIN=https://trip.example.com

# Use long URL-safe values so they can be embedded in service URLs.
POSTGRES_USER=trip_planner
POSTGRES_PASSWORD=CHANGE_ME_LONG_URL_SAFE_PASSWORD
POSTGRES_DB=trip_planner
REDIS_PASSWORD=CHANGE_ME_LONG_URL_SAFE_PASSWORD

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AMAP_API_KEY=
# Disabled by default because hello-agents 0.2.9 constrains FastMCP below its patched major release.
# HTTP fallback remains available when AMAP_API_KEY is configured.
AMAP_MCP_ENABLED=false
AMAP_MCP_COMMAND=mcp-amap
AMAP_MCP_ARGS=[]
AMAP_MCP_STARTUP_TIMEOUT_SECONDS=90
AMAP_MCP_CALL_TIMEOUT_SECONDS=20
AMAP_MCP_HTTP_FALLBACK=true
BAIDU_MAP_API_KEY=
UNSPLASH_ACCESS_KEY=
ENABLE_EXTERNAL_SERVICES=true
USE_ENHANCED_PROMPT=true
ENABLE_LLM_TOOL_PLANNING=true
ENABLE_PYDANTIC_AI_PLANNER=false
PYDANTIC_AI_REQUEST_LIMIT=12
PYDANTIC_AI_TOOL_CALL_LIMIT=8
PYDANTIC_AI_TOOL_ROUND_LIMIT=3
ENABLE_PLAN_CRITIQUE=true
MAX_REFINEMENT_ROUNDS=3
MIN_PASS_SCORE=7.0
TASK_RESULT_TTL_DAYS=30
TASK_WORKER_TIMEOUT_SECONDS=900
TASK_SSE_TIMEOUT_SECONDS=300
TASK_MAINTENANCE_INTERVAL_SECONDS=60
TASK_STALE_QUEUED_SECONDS=300
MAX_CONVERSATION_MESSAGES=20
RATE_LIMIT_PER_MINUTE=60
